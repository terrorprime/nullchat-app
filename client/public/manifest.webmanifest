{
  "id": "/",
  "name": "NullChat",
  "short_name": "NullChat",
  "description": "Chat, voice and video with your friends and communities.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/channels/@me",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#040405",
  "theme_color": "#040405",
  "categories": ["social", "communication"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Friends & messages", "short_name": "Messages", "url": "/channels/@me", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/screenshots/chat.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Chat in a server" },
    { "src": "/screenshots/login.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Log in" }
  ]
}
