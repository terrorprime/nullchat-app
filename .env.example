# ─────────────────────────────────────────────────────────────────────────────
#  NullChat configuration. `npm run setup` copies this file to .env and fills in
#  APP_SECRET for you. Restart the server after changing anything here.
# ─────────────────────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# Port the NullChat server listens on (the dev web client runs on 5173 and proxies to this).
PORT=3001
HOST=0.0.0.0

# The address people type into their browser to reach NullChat. Used in email links.
# Development: http://localhost:5173   Production: https://chat.example.com
PUBLIC_URL=http://localhost:5173

# Long random string used to sign login tickets. KEEP IT SECRET. Required in production.
APP_SECRET=change-me

# Where the SQLite database and uploaded files are stored (relative to the project root).
DATA_DIR=data

# Set to true when running behind a reverse proxy (nginx, Caddy, Render, Railway, ...).
TRUST_PROXY=false

# Automatic database backups into DATA_DIR/backups (on by default in production).
# BACKUPS=true
# BACKUP_EVERY_HOURS=12
# BACKUP_KEEP=3

# Maximum attachment size in megabytes.
MAX_UPLOAD_MB=150

# Allow new sign-ups.
REGISTRATION_OPEN=true

# Site admins who can open User Settings -> Admin Panel (see and remove users and servers).
# Usernames or emails, comma separated. Leave empty and the OLDEST account is the admin.
ADMIN_USERS=

# ── Email (password reset) ────────────────────────────────────
# Leave SMTP_HOST empty in development: emails are printed in the server terminal
# and shown at http://localhost:3001/api/dev/outbox instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NullChat <no-reply@example.com>

# ── Optional features ────────────────────────────────────────────────────────
# GIF picker: create a free API key at https://developers.giphy.com/
GIPHY_API_KEY=

# Rich link previews (the server fetches pages to build previews).
LINK_PREVIEWS=true

# ── Voice & video (WebRTC) ───────────────────────────────────────────────────
# STUN works on most home networks. For reliable calls over the internet (mobile
# networks, strict NATs, corporate Wi-Fi) add a TURN server, e.g. coturn or a hosted one.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Or borrow Cloudflare's relay (free for the first 1,000 GB): make a TURN key in the
# Cloudflare dashboard (Realtime > TURN Server) and put its two values here.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── Big calls (optional) ─────────────────────────────────────────────────────
# Calls are direct between people, which is best up to about 8. For bigger calls and screen shares
# watched by many, connect a LiveKit server (LiveKit Cloud has a free plan). Set all three, or none.
# See docs/BIG_CALLS.md.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Phone app notifications (optional) ───────────────────────────────────────
# Only for the Android and iPhone apps built from the mobile/ folder. Easiest is the helper, which checks the files and sets these for you:
#   node scripts/phone-notification-keys.cjs --android <firebase-key.json>     (add --env to print these lines instead)
# Android: the Firebase service account key file, either as the JSON itself or base64 of the file.
FCM_SERVICE_ACCOUNT=
FCM_SERVICE_ACCOUNT_B64=
# iPhone: the Apple .p8 notification key (itself or base64 of it), its Key ID, your Team ID and the app's bundle id (all four).
APNS_KEY=
APNS_KEY_B64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# true only for apps run straight from Xcode on your own phone; TestFlight and App Store builds need false.
APNS_SANDBOX=false
# See docs/PHONE_APPS.md.
